pragma language_version 0.23;
import CompactStandardLibrary;
include "protocol-v2/types";
include "protocol-v2/domains";
include "protocol-v2/derivations";
include "protocol-v2/merkle";
include "protocol-v2/candidate-roots";

// Phase 3C: constructor, nine fields, registration and revocation only.
export sealed ledger registryAuthorityControlCommitment: Bytes<32>;
export sealed ledger registryContext: Bytes<32>;
export ledger issuerRoot: Bytes<32>;
export ledger nextIssuerIndex: Uint<32>;
export ledger registeredIssuerLeaves: Set<Bytes<32>>;
export ledger credentialRoot: Bytes<32>;
export ledger nextCredentialIndex: Uint<32>;
export ledger registeredCredentialNullifiers: Set<Bytes<32>>;
export ledger revocationRoot: Bytes<32>;

witness registryAuthoritySecretWitness(): Bytes<32>;
export struct IssuerRegistrationWitnessV2 {
  registryAuthoritySecret: Bytes<32>,
  insertionPath: IssuerMerklePathV2
}
witness issuerRegistrationWitnessV2(): IssuerRegistrationWitnessV2;
export struct IssuerMembershipWitnessV2 {
  record: IssuerRecordV2,
  issuerIndex: Uint<16>,
  path: IssuerMerklePathV2
}
export struct CredentialRegistrationWitnessV2 {
  issuerSecret: Bytes<32>,
  credential: PrivateCredentialPackageV2,
  issuerMembership: IssuerMembershipWitnessV2,
  insertionPath: CredentialMerklePathV2
}
witness credentialRegistrationWitnessV2(): CredentialRegistrationWitnessV2;
export struct CredentialMembershipWitnessV2 {
  credentialIndex: Uint<16>,
  path: CredentialMerklePathV2
}
export struct CredentialRevocationWitnessV2 {
  issuerSecret: Bytes<32>,
  issuerMembership: IssuerMembershipWitnessV2,
  issuanceNonce: Bytes<32>,
  credentialId: Bytes<32>,
  credentialCommitment: Bytes<32>,
  credentialMembership: CredentialMembershipWitnessV2,
  revocationPath: RevocationMerklePathV2
}
witness credentialRevocationWitnessV2(): CredentialRevocationWitnessV2;
// Retained demo schema identifier: SHA-256 of JP:QUALIFICATION:MIDNIGHT-BUILDER-DEMO:V1.
circuit demoQualificationV2(): Bytes<32> {
  return [50,22,194,187,119,39,36,78,37,111,227,167,246,232,157,20,139,54,54,211,27,82,93,189,67,109,151,202,146,42,61,183] as Bytes<32>;
}
constructor(deploymentRegistryContext: Bytes<32>) {
  assert(deploymentRegistryContext != default<Bytes<32>>, "registry context zero");
  const secret = registryAuthoritySecretWitness();
  assert(secret != default<Bytes<32>>, "authority secret zero");
  // Context is ledger-public configuration. Only the final control hash is disclosed.
  registryContext = disclose(deploymentRegistryContext);
  registryAuthorityControlCommitment = disclose(authorityControlV2(deploymentRegistryContext,secret));
  issuerRoot = candidateIssuerRootV2();
  nextIssuerIndex = 0;
  credentialRoot = candidateCredentialRootV2();
  nextCredentialIndex = 0;
  revocationRoot = candidateRevocationRootV2();
  // Sets have canonical empty initial state; no initial entries or extra state.
}

export circuit registerIssuerV2(issuerControlCommitment: Bytes<32>): [] {
  const context = registryContext;
  const authority = registryAuthorityControlCommitment;
  assert(issuerControlCommitment != default<Bytes<32>>, "issuer control zero");
  const w = issuerRegistrationWitnessV2();
  assert(w.registryAuthoritySecret != default<Bytes<32>>, "authority secret zero");
  assert(authorityControlV2(context,w.registryAuthoritySecret) == authority, "authority control mismatch");
  const next = nextIssuerIndex;
  assert(next < 65536, "tree full");
  const index = next as Uint<16>;
  const id = issuerIdV2(context,issuerControlCommitment);
  const record = IssuerRecordV2 { protocolVersion: 2, issuerId: id, issuerControlCommitment: issuerControlCommitment };
  // Final leaf is public in the duplicate Set; no secret or raw commitment disclosure.
  const leaf = disclose(issuerLeafV2(record));
  assert(!registeredIssuerLeaves.member(leaf), "duplicate issuer leaf");
  emptySlotV2(DOMAIN_ISSUER_MERKLE_NODE_V2(),issuerEmptyV2(),index,next,w.insertionPath.siblings,issuerRoot);
  const newRoot = rootFromV2(DOMAIN_ISSUER_MERKLE_NODE_V2(),leaf,index,w.insertionPath.siblings);
  const incremented = (next + 1) as Uint<32>;
  // Only the final tree root is disclosed for the public root write.
  issuerRoot = disclose(newRoot);
  nextIssuerIndex = incremented;
  registeredIssuerLeaves.insert(leaf);
}

export circuit registerCredentialV2(): [] {
  const w = credentialRegistrationWitnessV2();
  const context = registryContext;
  const issuerCount = nextIssuerIndex;
  const currentIssuerRoot = issuerRoot;
  assert(issuerCount <= 65536, "invalid issuer counter");
  const record = w.issuerMembership.record;
  assert(record.protocolVersion == 2, "issuer protocol version");
  assert(record.issuerControlCommitment != default<Bytes<32>>, "issuer control zero");
  const issuerId = issuerIdV2(context,record.issuerControlCommitment);
  assert(issuerId == record.issuerId, "noncanonical issuer id");
  membershipV2(DOMAIN_ISSUER_MERKLE_NODE_V2(),issuerLeafV2(record),w.issuerMembership.issuerIndex,issuerCount,w.issuerMembership.path.siblings,currentIssuerRoot);
  assert(w.issuerSecret != default<Bytes<32>>, "issuer secret zero");
  assert(issuerControlV2(context,w.issuerSecret) == record.issuerControlCommitment, "issuer control mismatch");
  const statement = w.credential.statement;
  assert(statement.protocolVersion == 2, "credential protocol version");
  assert(statement.qualificationType == demoQualificationV2(), "qualification type");
  assert(statement.qualificationVersion == 1, "qualification version");
  assert(statement.issuedAt > 0, "issuedAt zero");
  assert(statement.expiresAt == 0 || statement.expiresAt > statement.issuedAt, "invalid expiry");
  assert(w.credential.issuanceNonce != default<Bytes<32>>, "issuance nonce zero");
  assert(w.credential.credentialOpening != default<Bytes<32>>, "credential opening zero");
  assert(statement.subjectCommitment != default<Bytes<32>>, "subject commitment zero");
  assert(statement.issuerId == issuerId, "credential issuer mismatch");
  const id = credentialIdV2(issuerId,w.credential.issuanceNonce);
  assert(id == statement.credentialId, "credential id mismatch");
  const commitment = credentialCommitmentV2(statement,w.credential.credentialOpening);
  const leaf = credentialLeafV2(id,commitment);
  // Only the final duplicate-guard nullifier is public, never its private preimage.
  const nullifier = disclose(registrationNullifierV2(kernel.self(),context,id));
  assert(!registeredCredentialNullifiers.member(nullifier), "duplicate credential nullifier");
  const next = nextCredentialIndex;
  assert(next < 65536, "credential tree full");
  const index = next as Uint<16>;
  emptySlotV2(DOMAIN_CREDENTIAL_MERKLE_NODE_V2(),credentialEmptyV2(),index,next,w.insertionPath.siblings,credentialRoot);
  const newRoot = rootFromV2(DOMAIN_CREDENTIAL_MERKLE_NODE_V2(),leaf,index,w.insertionPath.siblings);
  const incremented = (next + 1) as Uint<32>;
  // Only the final root is acknowledged for the public state write.
  credentialRoot = disclose(newRoot);
  nextCredentialIndex = incremented;
  registeredCredentialNullifiers.insert(nullifier);
}

export circuit revokeCredentialV2(): [] {
  const w = credentialRevocationWitnessV2();
  const context = registryContext;
  const issuerCount = nextIssuerIndex;
  const currentIssuerRoot = issuerRoot;
  assert(issuerCount <= 65536, "invalid issuer counter");
  const record = w.issuerMembership.record;
  assert(record.protocolVersion == 2, "issuer protocol version");
  assert(record.issuerControlCommitment != default<Bytes<32>>, "issuer control zero");
  const issuerId = issuerIdV2(context,record.issuerControlCommitment);
  assert(issuerId == record.issuerId, "noncanonical issuer id");
  membershipV2(DOMAIN_ISSUER_MERKLE_NODE_V2(),issuerLeafV2(record),w.issuerMembership.issuerIndex,issuerCount,w.issuerMembership.path.siblings,currentIssuerRoot);
  assert(w.issuerSecret != default<Bytes<32>>, "issuer secret zero");
  assert(issuerControlV2(context,w.issuerSecret) == record.issuerControlCommitment, "issuer control mismatch");
  assert(w.issuanceNonce != default<Bytes<32>>, "issuance nonce zero");
  const id = credentialIdV2(issuerId,w.issuanceNonce);
  assert(id == w.credentialId, "credential id mismatch");
  const leaf = credentialLeafV2(id,w.credentialCommitment);
  const credentialCount = nextCredentialIndex;
  const currentCredentialRoot = credentialRoot;
  assert(credentialCount <= 65536, "invalid credential counter");
  const index = w.credentialMembership.credentialIndex;
  membershipV2(DOMAIN_CREDENTIAL_MERKLE_NODE_V2(),leaf,index,credentialCount,w.credentialMembership.path.siblings,currentCredentialRoot);
  const currentRevocationRoot = revocationRoot;
  assert(rootFromV2(DOMAIN_REVOCATION_MERKLE_NODE_V2(),notRevokedV2(),index,w.revocationPath.siblings) == currentRevocationRoot, "not revoked root");
  const revoked = revokedLeafV2(id,w.credentialCommitment);
  const newRoot = rootFromV2(DOMAIN_REVOCATION_MERKLE_NODE_V2(),revoked,index,w.revocationPath.siblings);
  // Only the final root is disclosed; the credential-bound leaf remains private.
  revocationRoot = disclose(newRoot);
}
