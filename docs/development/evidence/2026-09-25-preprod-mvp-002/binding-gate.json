  "claims": [
    {
      "requirement": "Public spent-output owner",
      "result": "PUBLIC_API_SURFACE_ESTABLISHED; finalized-server semantics not independently established",
      "evidence": [
        "indexerTypes",
        "indexerImpl"
      ],
      "finding": "Schema comments identify outputs consumed by the transaction, and executable TX_ID_QUERY requests owner, intentHash, tokenType and value. This is not merely a suggestive field name."
    },
    {
      "requirement": "1AM 4.0.0 construction of required owner spend",
      "result": "UNRESOLVED",
      "evidence": [
        "connector400",
        "spec400",
        "facadeImpl"
      ],
      "finding": "makeIntent requests unshielded token kind/type/amount; no owner or receipt-action argument. Wallet coin selection is intentionally private. Nonzero requested inputs may produce an unshielded spend but do not guarantee the claimed owner or receipt consent. 1AM implementation is not locally available; public declaration is not vendor support evidence."
    },
    {
      "requirement": "Balancing/fee guarantees",
      "result": "NO_GENERAL_GUARANTEE",
      "evidence": [
        "connector400",
        "facadeImpl"
      ],
      "finding": "Balancing adds necessary inputs/outputs, not an unconditional claimed-owner spend. initSwap separately requests unshielded swaps and optional DUST fee balancing. A fee or created output is not address-control proof."
    },
    {
      "requirement": "Same transaction and cryptographic receipt linkage",
      "result": "STRUCTURAL_COOCCURRENCE_POSSIBLE; COMPLETE_LINKAGE_UNRESOLVED",
      "evidence": [
        "ledger",
        "indexerTypes"
      ],
      "finding": "RegularTransaction groups contractActions and consumed outputs. UnshieldedOffer documents input-authorizing signatures over Intent.signatureData; intents have their own actions and offers. Transaction.merge permits composition, so co-membership alone is not evidence that an input signer authorized an arbitrary subsequently associated receipt. Need a supported construction with the required signed intent/action binding and replay constraints, not just a form address or merged unrelated transfer."
    },
    {
      "requirement": "Address substitution resistance",
      "result": "UNRESOLVED",
      "evidence": [
        "ledger",
        "indexerTypes",
        "previousGate"
      ],
      "finding": "Public hash of supplied address/campaign/receipt ID is computable by anyone. A verifier must derive canonical owner from authorized consumed input, reject mismatch, and prove signed receipt linkage. No complete constructor/verifier pipeline is established."
    },
    {
      "requirement": "Independent finality query and confirmation depth",
      "result": "PROVIDER_CONTRACT_IDENTIFIED; DEPLOYED_FINALITY_GUARANTEE_UNRESOLVED",
      "evidence": [
        "indexerImpl",
        "publicProviderContract"
      ],
      "finding": "watchForTxData uses transactions(offset:{identifier:txId}), returns first regular result, deserializes raw and maps execution/segment status. Public API promises finalized data. Implementation has no independent finalized-head/depth check; relies on indexer semantics. No numeric confirmation depth established; do not invent N-block finality. Pinned service implementation or authoritative version-matched indexing guarantee and endpoint identity would be required."
    },
    {
      "requirement": "Independent verification and duplicate prevention",
      "result": "NOT_IMPLEMENTED; BINDING_GATE_BLOCKED",
      "evidence": [
        "indexerImpl",
        "indexerTypes"
      ],
      "finding": "Query requires transaction identifier, not private wallet data; public consumed owner and action evidence could support review. Contract receipt schema, signed linkage, finality policy and authoritative duplicate key (canonical address,campaign) remain unestablished. No VERIFIED result can be issued."
    }
  ],
  "hardStops": [
    "No complete owner-enforced 1AM connector construction for the receipt",
    "No established signature-to-receipt linkage across possible merged intents",
    "No independently established version-matched service finality policy/confirmation rule"
